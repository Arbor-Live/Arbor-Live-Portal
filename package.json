{
  "name": "arbor-live-portal",
  "private": true,
  "packageManager": "pnpm@10.34.3+sha512.f2c531b08829d7be7f03c90addc266615f9c5477463e4bf1d275cb263ce9ea57cf0d5599110d94649a9bb3fed9f0b5efcea74a7016b61532a24cb9ad87860c1d",
  "pnpm": {
    "overrides": {
      "@better-fetch/fetch": "1.3.1",
      "better-call": "1.3.7"
    },
    "patchedDependencies": {
      "@convex-dev/better-auth@0.12.3": "patches/@convex-dev__better-auth@0.12.3.patch"
    }
  },
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:email": "pnpm --filter @arbor/email email:dev",
    "codegen:backend": "pnpm --filter backend codegen",
    "auth:generate": "pnpm --filter backend auth:generate",
    "dev": "pnpm -r --parallel --stream dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e-run.mjs",
    "test:e2e:skip-boot": "E2E_SKIP_BOOT=1 node scripts/e2e-run.mjs",
    "test:e2e:ui": "pnpm --filter web exec playwright test --ui",
    "test:e2e:codegen": "pnpm --filter web exec playwright codegen http://localhost:3000",
    "setup:worktree-env": "node scripts/link-worktree-env.mjs",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true && node scripts/link-worktree-env.mjs 2>/dev/null || true"
  },
  "dependencies": {
    "convex": "^1.43.0",
    "papaparse": "^5.5.4"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "vitest": "^4.1.10"
  }
}
