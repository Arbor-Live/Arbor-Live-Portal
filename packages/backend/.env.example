BETTER_AUTH_SECRET=replace-with-generated-secret
SITE_URL=http://localhost:3000
# Set to "production" on the prod Convex deployment only.
# ARBOR_ENV=production
CONVEX_CLOUD_URL=https://your-convex-deployment.convex.cloud
CONVEX_SITE_URL=https://your-convex-deployment.convex.site
BOOTSTRAP_ADMIN_SECRET=replace-with-strong-random-secret
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Arbor Notifications <noreply@arbor.st>

# Cloudflare R2 (@convex-dev/r2 — set in Convex dashboard)
# R2_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=
# Public custom domain for serving uploaded files (read-only; no trailing slash)
R2_PUBLIC_BASE_URL=https://assets.example.com

# Self-hosted Immich — Convex creates albums and upload share links (IMMICH_API_KEY stays server-side).
# Set these in the Convex dashboard for each deployment.
IMMICH_URL=https://photos.example.com
IMMICH_API_KEY=your-immich-api-key

# PostPeer — Instagram publishing when marketing designs are marked ready.
# Set in the Convex dashboard (server-side only).
POSTPEER_ACCESS_KEY=your-postpeer-access-key
POSTPEER_INSTAGRAM_ACCOUNT_ID=your-instagram-account-id
