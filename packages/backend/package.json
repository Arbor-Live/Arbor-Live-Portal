{
  "name": "backend",
  "private": true,
  "type": "module",
  "exports": {
    "./convex/_generated/api": "./convex/_generated/api.js",
    "./convex/_generated/dataModel": "./convex/_generated/dataModel.d.ts"
  },
  "scripts": {
    "dev": "convex dev",
    "build": "pnpm --dir ../../apps/web run build",
    "codegen": "convex codegen",
    "migrate": "convex run migrations:runAll",
    "migrate:prod": "convex run migrations:runAll --prod",
    "auth:generate": "cd convex/betterAuth && better-auth generate -y",
    "deploy": "convex deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@arbor/email": "workspace:*",
    "@arbor/format": "workspace:*",
    "@arbor/invoice-document": "workspace:*",
    "@arbor/rider-document": "workspace:*",
    "@arbor/show-file": "workspace:*",
    "@better-auth/passkey": "^1.7.12",
    "@convex-dev/better-auth": "0.12.3",
    "@convex-dev/migrations": "^0.3.7",
    "@convex-dev/r2": "^0.10.4",
    "@convex-dev/resend": "^0.2.9",
    "@react-email/render": "^2.1.1",
    "better-auth": "^1.7.12",
    "convex": "^1.47.0",
    "nanoid": "^6.0.2",
    "react-email": "^6.11.3",
    "resend": "^6.34.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^26.6.5",
    "@types/web-push": "^3.6.4",
    "convex-test": "^0.0.61",
    "typescript": "^7.0.2"
  }
}
